{
  "name": "@webship-js/wordpress-steps",
  "version": "2.2.0",
  "description": "WordPress step definitions for webship-js (Playwright and Cucumber): sessions and roles, the administration area, the block editor, comments, search, the REST API, feeds and accessibility.",
  "main": "tests/step-definitions/wordpress.steps.js",
  "files": [
    "tests/step-definitions/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "webship-js",
    "wordpress",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "step-definitions",
    "wordpress-testing",
    "e2e-testing"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/wordpress-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/wordpress-steps/issues"
  },
  "homepage": "https://github.com/webship/wordpress-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.6"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "webship-js": "^2.0.6"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
